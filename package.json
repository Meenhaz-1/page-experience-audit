{
  "name": "page-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "tsx src/cli.ts",
    "audit:chrome": "./scripts/run-attached-audit.sh audit",
    "quick-check": "tsx src/quick-check/cli.ts",
    "quick-check:chrome": "./scripts/run-attached-audit.sh quick-check",
    "quick-check:chrome:ai": "./scripts/run-attached-audit.sh quick-check --ai-mode structured_summary",
    "usability": "tsx src/usability/cli.ts",
    "api": "tsx src/api.ts",
    "mcp": "tsx src/mcp-server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
